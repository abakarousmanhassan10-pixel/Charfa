# ─── TOUMA environment template ───────────────────────────────────────
# Copy to .env (root) for local development. NEVER commit real secrets.
# Generate secrets with:  openssl rand -base64 48   (JWT)   |   openssl rand -base64 32   (encryption key)

NODE_ENV=development
APP_ENV=local

# Database / cache
DATABASE_URL=postgresql://touma:touma_dev_password@localhost:5432/touma?schema=public
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Leave unset to derive from NODE_ENV (secure cookies in production).
# COOKIE_SECURE=true

# Auth (min 32 chars each, must differ)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# AES-256-GCM key for OAuth token encryption: 32 random bytes, base64
TOKEN_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10
AUTH_REFRESH_THROTTLE_LIMIT=60
# redis = counters shared by every API instance (required in production); memory = single process only
RATE_LIMIT_STORE=redis

# Max businesses one user may own (abuse guard until plan limits in Phase 10)
MAX_OWNED_BUSINESSES=5

# ─── Optional integrations (unset = "not configured") ────────────────────────
# ─── TOUMA AI engine ─────────────────────────────────────────────────────────
# Provider: openai. Without OPENAI_API_KEY the AI pages show "not configured" (nothing is simulated).
AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORGANIZATION=
# Any model that supports Structured Outputs (json_schema strict).
AI_MODEL=gpt-4o-mini
# Empty = per-agent defaults (analysis 0.3, strategy 0.6, content 0.8)
AI_TEMPERATURE=
AI_MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT_MS=90000
AI_MAX_PROVIDER_RETRIES=2
AI_MAX_REPAIR_ATTEMPTS=1
AI_MONTHLY_GENERATIONS_PER_BUSINESS=300
AI_MONTHLY_TOKENS_PER_BUSINESS=3000000
AI_RATE_LIMIT_PER_MINUTE=10
# USD per 1M tokens for your model (see the provider's pricing page). 0 = cost not tracked.
AI_INPUT_COST_PER_1M_TOKENS=0
AI_OUTPUT_COST_PER_1M_TOKENS=0
# Per-model prices (JSON, USD per 1M tokens). Takes precedence over the flat prices above.
# AI_MODEL_PRICING={"gpt-4o-mini":{"inputPerMillion":0.15,"outputPerMillion":0.6}}

# Generation runs in a BullMQ worker. Production: run `node dist/ai-worker.js` (same image as the API) and keep this false.
# Development: set true to run the worker inside the API process.
AI_WORKER_INLINE=false
AI_WORKER_CONCURRENCY=4
AI_WORKER_HEALTH_PORT=4002
AI_JOB_ATTEMPTS=3
AI_JOB_BACKOFF_MS=5000
# Tokens held per reserved generation until the measured usage is known; stale reservations are released after this many minutes.
AI_TOKENS_RESERVED_PER_GENERATION=12000
AI_RESERVATION_STALE_MINUTES=120

# ---- Creative Studio (AI images and videos) ----
# Images: provider openai (model gpt-image-1) needs OPENAI_API_KEY (same key as TOUMA AI). Without it the image pages
# show "not configured" and nothing is simulated. "fake" exists for automated tests only and is refused unless APP_ENV=test.
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-1
# Videos: "none" (default) means no video is ever generated or faked. "openai" uses the Sora-style /videos API and needs an
# OPENAI_API_KEY with video access. Set VIDEO_PROVIDER=openai only after verifying your account has access.
VIDEO_PROVIDER=none
VIDEO_MODEL=sora-2
CREATIVE_PROVIDER_TIMEOUT_MS=180000
# Monthly limits per business when no plan limit applies (a plan's aiImagesPerMonth / aiVideoSecondsPerMonth wins).
CREATIVE_MONTHLY_IMAGES_PER_BUSINESS=100
CREATIVE_MONTHLY_VIDEO_SECONDS_PER_BUSINESS=120
CREATIVE_RATE_LIMIT_PER_MINUTE=10
# Background jobs (run by the same process as the AI worker: `node dist/ai-worker.js`).
CREATIVE_WORKER_CONCURRENCY=2
CREATIVE_JOB_ATTEMPTS=3
CREATIVE_JOB_BACKOFF_MS=5000
CREATIVE_VIDEO_POLL_MS=5000
CREATIVE_VIDEO_TIMEOUT_MINUTES=15
# Cost estimates (JSON, USD). Copy the real prices from your provider's pricing page; without them cost shows as unknown.
# CREATIVE_MODEL_PRICING={"gpt-image-1":{"perImageUsd":0.04},"sora-2":{"perSecondUsd":0.1}}

# ---- Content calendar scheduler (runs inside `node dist/ai-worker.js`) ----
CALENDAR_TICK_MS=15000
CALENDAR_DISPATCH_ATTEMPTS=3
CALENDAR_DISPATCH_BACKOFF_MS=5000
# "Upcoming publication" notification this many minutes before an authorized entry is due.
CALENDAR_REMINDER_MINUTES=60
# A hand-off claim older than this is treated as abandoned (worker crash) and recovered.
CALENDAR_LOCK_SECONDS=120
CALENDAR_RATE_LIMIT_PER_MINUTE=60

# ---- Social platforms (OAuth + publishing). See docs/SOCIAL-INTEGRATIONS.md ----
# Public https address of this API: OAuth redirect URIs, webhooks and the media URLs the platforms download from.
# PUBLIC_API_URL=https://api.example.com
# Facebook Pages and Instagram (one Meta app)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# META_WEBHOOK_VERIFY_TOKEN=at-least-16-characters
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# YouTube (Google OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202411
# Set false if the LinkedIn app is not approved for Company Page scopes (Community Management API).
LINKEDIN_ORG_SCOPES=true
# live = real platform APIs. "fake" is a test-only simulator and is refused unless APP_ENV=test.
SOCIAL_PROVIDER_MODE=live
SOCIAL_STATE_TTL_MINUTES=10
SOCIAL_TOKEN_REFRESH_AHEAD_HOURS=24
SOCIAL_TOKEN_WARN_DAYS=7
SOCIAL_PUBLISH_ATTEMPTS=3
SOCIAL_PUBLISH_BACKOFF_MS=10000
SOCIAL_WORKER_CONCURRENCY=3
SOCIAL_TICK_MS=30000
SOCIAL_PROCESSING_TIMEOUT_MINUTES=30
SOCIAL_RATE_LIMIT_PER_MINUTE=30

# S3-compatible object storage. Server-side only: the browser never receives these credentials;
# media is served through short-lived signed API URLs and the bucket stays private.
#   AWS S3:        S3_PROVIDER=aws   S3_REGION=eu-west-3  (leave S3_ENDPOINT empty)
#   Cloudflare R2: S3_PROVIDER=r2    S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  (region "auto")
#   MinIO:         S3_PROVIDER=minio S3_ENDPOINT=http://localhost:9000  (path-style addressing)
# Local MinIO from docker compose: access key touma-minio / secret touma-minio-dev-password.
# Verify with a real round trip:  pnpm --filter @touma/api storage:check
STORAGE_DRIVER=s3
S3_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=touma-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Create the bucket on first use (local only; refused in production/staging).
S3_AUTO_CREATE_BUCKET=true
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=200
MEDIA_URL_TTL_SECONDS=3600
# Decoded-pixel limit per image (decompression-bomb guard) and default per-business quota.
MEDIA_MAX_IMAGE_PIXELS=40000000
MEDIA_STORAGE_QUOTA_MB=1024

# Malware scanning of every upload (clamd INSTREAM). Required in production unless
# ALLOW_UNSCANNED_UPLOADS=true is set explicitly. Uploads fail closed when the scanner is down.
MALWARE_SCANNER=none
# MALWARE_SCANNER=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
# ALLOW_UNSCANNED_UPLOADS=false

# Transactional email (verification, password reset, invitations).
# log = development only: emails are written to the API log (links included). Production requires smtp.
EMAIL_TRANSPORT=log
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
EMAIL_FROM="TOUMA AI <no-reply@localhost>"

# Worker liveness endpoint (GET /health)
WORKER_HEALTH_PORT=4001

# Plans (seed only; prices are editable afterwards)
PLAN_STARTER_PRICE=19.00
PLAN_PRO_PRICE=49.00
PLAN_BUSINESS_PRICE=99.00
PLAN_STARTER_PROVIDER_PRICE_ID=
PLAN_PRO_PROVIDER_PRICE_ID=
PLAN_BUSINESS_PROVIDER_PRICE_ID=
