# ─── TOUMA environment template ───────────────────────────────────────
# Copy to .env (root) for local development. NEVER commit real secrets.
# Generate secrets with:  openssl rand -base64 48   (JWT)   |   openssl rand -base64 32   (encryption key)

NODE_ENV=development
APP_ENV=local

# Database / cache
DATABASE_URL=postgresql://touma:touma_dev_password@localhost:5432/touma?schema=public
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Leave unset to derive from NODE_ENV (secure cookies in production).
# COOKIE_SECURE=true

# Auth (min 32 chars each, must differ)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# AES-256-GCM key for OAuth token encryption: 32 random bytes, base64
TOKEN_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# ─── Optional integrations (unset = "not configured") ────────────────────────
OPENAI_API_KEY=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=touma-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Plans (seed only; prices are editable afterwards)
PLAN_STARTER_PRICE=19.00
PLAN_PRO_PRICE=49.00
PLAN_BUSINESS_PRICE=99.00
PLAN_STARTER_PROVIDER_PRICE_ID=
PLAN_PRO_PROVIDER_PRICE_ID=
PLAN_BUSINESS_PROVIDER_PRICE_ID=
