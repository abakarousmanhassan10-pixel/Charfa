  "info": {
    "title": "TOUMA AI API",
    "description": "Your Business. Your AI Marketing Team. — TOUMA REST API v1",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "touma_rt"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "owner@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "description": "Lowercase, uppercase and a digit required"
          },
          "fullName": {
            "type": "string",
            "example": "Amina Diallo"
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "fr"
            ],
            "default": "en"
          }
        },
        "required": [
          "email",
          "password",
          "fullName"
        ]
      },
      "AuthUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "platformRole": {
            "type": "string",
            "enum": [
              "USER",
              "SUPPORT",
              "SUPER_ADMIN"
            ]
          },
          "emailVerified": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "fullName",
          "locale",
          "timezone",
          "platformRole",
          "emailVerified",
          "createdAt"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived JWT; send as Authorization: Bearer <token>"
          },
          "accessTokenExpiresIn": {
            "type": "number",
            "description": "Seconds until the access token expires"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserResponse"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresIn",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "owner@example.com"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "fr"
            ]
          },
          "timezone": {
            "type": "string",
            "example": "Africa/Ndjamena"
          }
        }
      },
      "CreateBusinessDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Café Awa"
          },
          "type": {
            "type": "string",
            "enum": [
              "ECOMMERCE",
              "RESTAURANT",
              "RETAIL_STORE",
              "SMALL_BUSINESS",
              "BRAND",
              "AGENCY",
              "FREELANCER",
              "SERVICE_PROVIDER",
              "OTHER"
            ]
          },
          "description": {
            "type": "object"
          },
          "website": {
            "type": "object",
            "example": "https://cafe-awa.example"
          },
          "industry": {
            "type": "object"
          },
          "country": {
            "type": "object",
            "example": "TD",
            "description": "ISO 3166-1 alpha-2"
          },
          "defaultLocale": {
            "type": "string",
            "enum": [
              "en",
              "fr"
            ],
            "default": "en"
          },
          "timezone": {
            "type": "string",
            "example": "Africa/Ndjamena",
            "default": "UTC"
          },
          "currency": {
            "type": "string",
            "example": "XAF",
            "default": "USD",
            "description": "ISO 4217"
          },
          "brandVoice": {
            "type": "object"
          },
          "targetAudience": {
            "type": "object"
          },
          "objectives": {
            "type": "object"
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "UpdateBusinessDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Café Awa"
          },
          "type": {
            "type": "string",
            "enum": [
              "ECOMMERCE",
              "RESTAURANT",
              "RETAIL_STORE",
              "SMALL_BUSINESS",
              "BRAND",
              "AGENCY",
              "FREELANCER",
              "SERVICE_PROVIDER",
              "OTHER"
            ]
          },
          "description": {
            "type": "object"
          },
          "website": {
            "type": "object",
            "example": "https://cafe-awa.example"
          },
          "industry": {
            "type": "object"
          },
          "country": {
            "type": "object",
            "example": "TD",
            "description": "ISO 3166-1 alpha-2"
          },
          "defaultLocale": {
            "type": "string",
            "enum": [
              "en",
              "fr"
            ],
            "default": "en"
          },
          "timezone": {
            "type": "string",
            "example": "Africa/Ndjamena",
            "default": "UTC"
          },
          "currency": {
            "type": "string",
            "example": "XAF",
            "default": "USD",
            "description": "ISO 4217"
          },
          "brandVoice": {
            "type": "object"
          },
          "targetAudience": {
            "type": "object"
          },
          "objectives": {
            "type": "object"
          }
        }
      },
      "DeleteBusinessDto": {
        "type": "object",
        "properties": {
          "confirmName": {
            "type": "string",
            "description": "Must equal the business name exactly, to confirm deletion"
          }
        },
        "required": [
          "confirmName"
        ]
      },
      "UpdateMemberRoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "EDITOR",
              "VIEWER"
            ]
          }
        },
        "required": [
          "role"
        ]
      }
    }
  }
}