  OTHER
}

enum PlanCode {
  STARTER
  PRO
  BUSINESS
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum MetricSource {
  MEASURED // returned by a platform API
  ESTIMATED // computed/estimated by AI; never shown as measured
}

enum SnapshotPeriod {
  DAY
  WEEK
  MONTH
  LIFETIME
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum WebhookProvider {
  STRIPE
  META
  TIKTOK
  YOUTUBE
  OTHER
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum AIAgent {
  BUSINESS_ANALYST
  PRODUCT_ANALYST
  MARKETING_STRATEGIST
  CONTENT_CREATOR
  VISUAL_CREATOR
  VIDEO_CREATOR
  SCHEDULER
  CUSTOMER_SUPPORT
  PERFORMANCE_ANALYST
  ORCHESTRATOR
}

enum AITask {
  CONTENT_PLAN
  BUSINESS_ANALYSIS
  PRODUCT_ANALYSIS
  MARKETING_STRATEGY
  CONTENT
  STORYBOARD
}

enum AIGenerationStatus {
  QUEUED // accepted and waiting for (or waiting to retry in) a worker
  RUNNING // a worker is generating
  SUCCEEDED
  FAILED // provider or validation failure after retries
  BLOCKED // refused before calling the provider (limit reached, not configured)
}

enum CreativeKind {
  IMAGE
  VIDEO
}

enum CreativeStatus {
  QUEUED // accepted; waiting for a worker (or for its next retry / provider poll)
  RUNNING
  SUCCEEDED
  FAILED
}

enum AIReservationStatus {
  RESERVED // quota held while the job is queued or running
  COMMITTED // job finished; consumed units and tokens were moved to the usage counters
  RELEASED // job finished without consuming anything (nothing was billed)
}

enum MalwareScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED // scanner not configured (development only; refused in production unless explicitly allowed)
  ERROR
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum KnowledgeSource {
  BUSINESS_PROFILE
  PRODUCT
  SERVICE
  POLICY
  FAQ
  MANUAL
}

// ─────────────────────────────── Identity ───────────────────────────────

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  passwordHash     String
  fullName         String
  locale           String       @default("en")
  timezone         String       @default("UTC")
  platformRole     PlatformRole @default(USER)
  status           UserStatus   @default(ACTIVE)
  emailVerifiedAt  DateTime?    @db.Timestamptz(3)
  lastLoginAt      DateTime?    @db.Timestamptz(3)
  failedLoginCount Int          @default(0)
  lockedUntil      DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?    @db.Timestamptz(3)

  sessions            Session[]
  memberships         Membership[]
  invitationsSent     Membership[]     @relation("MembershipInviter")
  customerNotes       CustomerNote[]   @relation("CustomerNoteAuthor")
  contentsCreated     Content[]        @relation("ContentCreator")
  contentsApproved    Content[]        @relation("ContentApprover")
  mediaUploaded       MediaAsset[]
  messagesAuthored    Message[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  aiUsages            AIUsage[]
  knowledgeVerified   KnowledgeEntry[] @relation("KnowledgeVerifier")
  aiGenerations       AIGeneration[]
  authTokens          AuthToken[]
  invitationsCreated  Invitation[]     @relation("InvitationInviter")
  invitationsAccepted Invitation[]     @relation("InvitationAcceptor")

  @@index([status])
  @@index([deletedAt])
}

/// Refresh-token session. Only a SHA-256 hash of the refresh token is stored.
/// Rotation: each refresh revokes the current session token and issues a new one in the same family.
/// Reuse of a revoked token revokes the whole family (token theft detection).
model Session {
  id               String    @id @default(cuid())
  userId           String
  familyId         String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  replacedById     String?   @unique
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz(3)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy Session? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   Session? @relation("SessionRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ─────────────────────────────── Tenancy ───────────────────────────────

model Business {
  id                String       @id @default(cuid())
  name              String
  slug              String       @unique
  type              BusinessType @default(OTHER)
  description       String?
  website           String?
  industry          String?
  country           String? // ISO 3166-1 alpha-2
  city              String?
  address           String?
  contactEmail      String?
  contactPhone      String? // E.164 recommended, stored as entered
  defaultLocale     String       @default("en")
  /// IANA timezone used for scheduling. Timestamps remain UTC; this is the display/scheduling zone.
  timezone          String       @default("UTC")
  currency          String       @default("USD") // ISO 4217
  brandVoice        String?
  targetAudience    String?
  objectives        String?
  logoMediaId       String?      @unique
  /// Per-business storage quota override in bytes (null = MEDIA_STORAGE_QUOTA_MB default).
  storageQuotaBytes BigInt?
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?    @db.Timestamptz(3)

  logo                MediaAsset?               @relation("BusinessLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  memberships         Membership[]
  products            Product[]
  services            Service[]
  socialAccounts      SocialAccount[]
  contents            Content[]
  mediaAssets         MediaAsset[]              @relation("BusinessMedia")
  calendarEvents      CalendarEvent[]
  publications        Publication[]
  conversations       Conversation[]
  comments            Comment[]
  subscription        Subscription?
  payments            Payment[]
  analyticsSnapshots  AnalyticsSnapshot[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  aiUsages            AIUsage[]
  knowledgeEntries    KnowledgeEntry[]
  categories          Category[]
  aiGenerations       AIGeneration[]
  invitations         Invitation[]
  aiUsagePeriods      AIUsagePeriod[]
  brandKit            BrandKit?
  contentPlans        ContentPlan[]
  recurrenceRules     RecurrenceRule[]
  approvalRecords     ApprovalRecord[]
  socialSessions      SocialConnectionSession[]
  creativeGenerations CreativeGeneration[]
  agentRuns           AgentRun[]
  workflowDefinitions WorkflowDefinition[]
  marketProducts      MarketProduct[]
  customers           Customer[]
  salesAgentConfig    SalesAgentConfig?
  campaigns           Campaign[]

  @@index([deletedAt])
  @@index([createdAt])
}

model Membership {
  id              String           @id @default(cuid())
  userId          String
  businessId      String
  role            BusinessRole
  status          MembershipStatus @default(ACTIVE)
  invitedById     String?
  invitedEmail    String?
  inviteTokenHash String?          @unique
  inviteExpiresAt DateTime?        @db.Timestamptz(3)
  joinedAt        DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy User?    @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([userId, businessId])
  @@index([businessId, status])
}

// ─────────────────────────────── Catalog ───────────────────────────────

model Product {
  id             String              @id @default(cuid())
  businessId     String
  name           String
  sku            String?
  description    String?
  features       String[]
  benefits       String[]
  targetAudience String?
  categoryId     String?
  price          Decimal?            @db.Decimal(12, 2)
  /// Promotional price; must be lower than price. Null = no discount.
  discountPrice  Decimal?            @db.Decimal(12, 2)
  currency       String?
  /// Null means stock is not tracked/unknown. AI must never invent stock levels.
  stockQuantity  Int?
  availability   ProductAvailability @default(IN_STOCK)
  url            String?
  status         CatalogStatus       @default(DRAFT)
  attributes     Json?
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?           @db.Timestamptz(3)

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category         Category?         @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  media            ProductMedia[]
  contents         Content[]
  campaignProducts CampaignProduct[]

  /// SKU is released (set to null) when a product is soft-deleted, so it can be reused.
  @@unique([businessId, sku])
  @@index([businessId, status])
  @@index([businessId, deletedAt])
  @@index([businessId, categoryId])
}

model Service {
  id                String              @id @default(cuid())
  businessId        String
  name              String
  description       String?
  features          String[]
  benefits          String[]
  targetAudience    String?
  categoryId        String?
  price             Decimal?            @db.Decimal(12, 2)
  currency          String?
  durationMinutes   Int?
  /// How customers book (e.g. "Call us", "Walk-in", "Online"), shown to customers and to the AI as fact.
  bookingInfo       String?
  bookingUrl        String?
  availability      ServiceAvailability @default(AVAILABLE)
  availabilityNotes String? // e.g. "Mon–Fri 9:00–18:00"
  status            CatalogStatus       @default(DRAFT)
  attributes        Json?
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?           @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation("ServiceCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  contents Content[]

  @@index([businessId, status])
  @@index([businessId, deletedAt])
  @@index([businessId, categoryId])
}

/// Business-defined category for products or services. Defaults are created from an industry template.
model Category {
  id          String       @id @default(cuid())
  businessId  String
  kind        CategoryKind
  name        String
  slug        String
  description String?
  isDefault   Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[] @relation("ProductCategory")
  services Service[] @relation("ServiceCategory")

  @@unique([businessId, kind, slug])
  @@index([businessId, kind, sortOrder])
}

/// Ordered product images/videos.
model ProductMedia {
  productId String
  mediaId   String
  position  Int    @default(0)

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
  @@index([mediaId])
}

/// Verified business knowledge used by the AI (customer support, content). Only APPROVED entries are used.
model KnowledgeEntry {
  id           String            @id @default(cuid())
  businessId   String
  source       KnowledgeSource
  sourceId     String?
  category     KnowledgeCategory @default(OTHER)
  title        String
  body         String
  /// Only verified entries are given to AI agents. Any edit resets verification.
  verified     Boolean           @default(false)
  verifiedAt   DateTime?         @db.Timestamptz(3)
  verifiedById String?
  createdById  String?
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?         @db.Timestamptz(3)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  verifiedBy User?    @relation("KnowledgeVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([businessId, verified])
  @@index([businessId, category])
  @@index([businessId, source, sourceId])
}

// ─────────────────────────────── Social ───────────────────────────────

model SocialAccount {
  id                String              @id @default(cuid())
  businessId        String
  platform          SocialPlatform
  externalAccountId String
  displayName       String?
  username          String?
  avatarUrl         String?
  status            SocialAccountStatus @default(CONNECTED)
  /// AES-256-GCM ciphertext (iv:tag:data, base64). Never returned by the API.
  accessTokenEnc    String
  refreshTokenEnc   String?
  tokenExpiresAt    DateTime?           @db.Timestamptz(3)
  scopes            String[]
  capabilities      Json? // provider-reported capabilities, e.g. { canPublishVideo: true }
  lastSyncedAt      DateTime?           @db.Timestamptz(3)
  lastError         String?
  /// PAGE, INSTAGRAM_BUSINESS, CHANNEL, PROFILE, ORGANIZATION, CREATOR. Not a secret.
  accountType       String?
  /// The parent object when there is one (for example the Facebook Page an Instagram account is linked to).
  parentExternalId  String?
  connectedAt       DateTime?           @db.Timestamptz(3)
  tokenRefreshedAt  DateTime?           @db.Timestamptz(3)
  refreshFailures   Int                 @default(0)
  lastRefreshError  String?
  /// Set when the "token is about to expire" warning was sent for the current expiry.
  expiryWarnedFor   DateTime?           @db.Timestamptz(3)
  /// Non-secret provider details (permissions the platform reported as granted or declined).
  metadata          Json?
  connectedById     String?
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?           @db.Timestamptz(3)

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  publications       Publication[]
  conversations      Conversation[]
  comments           Comment[]
  analyticsSnapshots AnalyticsSnapshot[]
  calendarEvents     CalendarEvent[]

  @@unique([businessId, platform, externalAccountId])
  @@index([businessId, platform])
  @@index([status, tokenExpiresAt])
}

// ─────────────────────────────── Content ───────────────────────────────

model Content {
  id              String           @id @default(cuid())
  businessId      String
  type            ContentType
  title           String?
  caption         String?
  language        String           @default("en")
  hashtags        String[]
  callToAction    String?
  targetPlatforms SocialPlatform[]
  status          ContentStatus    @default(DRAFT)
  origin          ContentOrigin    @default(HUMAN)
  productId       String?
  serviceId       String?
  campaignId      String? // parent CAMPAIGN content
  aiMetadata      Json? // prompt version, model, structured output; no secrets
  /// Per-platform posting choices a person made (for example TikTok privacy, interaction and disclosure settings). Editing them is a content change.
  platformOptions Json?
  version         Int              @default(1)
  createdById     String?
  approvedById    String?
  approvedAt      DateTime?        @db.Timestamptz(3)
  /// Content.version that a human approved; any later edit invalidates the approval.
  approvedVersion Int?
  rejectionReason String?
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?        @db.Timestamptz(3)

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  service        Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  campaign       Content?        @relation("CampaignItems", fields: [campaignId], references: [id], onDelete: SetNull)
  campaignItems  Content[]       @relation("CampaignItems")
  createdBy      User?           @relation("ContentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy     User?           @relation("ContentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  media          ContentMedia[]
  calendarEvents CalendarEvent[]
  publications   Publication[]
  aiGeneration   AIGeneration?

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId, deletedAt])
  @@index([campaignId])
}

model MediaAsset {
  id                 String            @id @default(cuid())
  businessId         String
  type               MediaType
  status             MediaStatus       @default(PENDING_UPLOAD)
  storageKey         String            @unique
  originalFilename   String
  /// Virtual folder for organization in the media library ("" = root).
  folder             String            @default("")
  tags               String[]
  mimeType           String
  sizeBytes          BigInt?
  width              Int?
  height             Int?
  durationSec        Decimal?          @db.Decimal(10, 3)
  checksumSha256     String?
  altText            String?
  origin             ContentOrigin     @default(HUMAN)
  aiProvider         String?
  aiPrompt           String?
  rejectionReason    String?
  /// Server-generated key of the WebP thumbnail (images only).
  thumbnailKey       String?
  thumbnailSizeBytes BigInt?
  /// Size of the file as uploaded, before re-encoding.
  originalSizeBytes  BigInt?
  scanStatus         MalwareScanStatus @default(PENDING)
  scanEngine         String?
  scannedAt          DateTime?         @db.Timestamptz(3)
  uploadedById       String?
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?         @db.Timestamptz(3)

  business        Business         @relation("BusinessMedia", fields: [businessId], references: [id], onDelete: Cascade)
  products        ProductMedia[]
  uploadedBy      User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  contents        ContentMedia[]
  logoOf          Business?        @relation("BusinessLogo")
  creativeOutputs CreativeOutput[]

  @@index([businessId, type])
  @@index([businessId, deletedAt])
  @@index([businessId, folder])
  @@index([status, createdAt])
}

/// Ordered media attached to content (carousel order).
model ContentMedia {
  contentId String
  mediaId   String
  position  Int    @default(0)

  content Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([contentId, mediaId])
  @@index([mediaId])
}

model CalendarEvent {
  id                  String              @id @default(cuid())
  businessId          String
  contentId           String?
  title               String
  notes               String?
  /// UTC instant.
  scheduledAt         DateTime            @db.Timestamptz(3)
  /// IANA timezone the user planned in, retained to render and to recompute across DST.
  timezone            String
  status              CalendarEventStatus @default(PLANNED)
  /// The platform this entry is for (one entry = one platform).
  platform            SocialPlatform?
  pillar              ContentPillar?
  brief               String?
  /// A merchant-supplied occasion (name + date) a SEASONAL entry refers to.
  occasion            String?
  planId              String?
  recurrenceId        String?
  /// The connected account this entry publishes to (default: the only connected account of the platform).
  socialAccountId     String?
  /// Local date (YYYY-MM-DD) of a recurrence occurrence; unique per rule so materialising twice is harmless.
  occurrenceDate      String?
  timeSource          TimeSource          @default(MANUAL)
  timeNote            String?
  /// `${contentId}:${platform}` while the placement is active (null when cancelled/deleted): one content per platform.
  placementKey        String?             @unique
  /// Explicit business authorization to publish this exact content version at this time.
  authorizedById      String?
  authorizedAt        DateTime?           @db.Timestamptz(3)
  authorizedVersion   Int?
  /// Hash of the exact tuple the person authorized (content version, media, platform, target account, schedule, timezone). Checked again before every dispatch.
  authorizedHash      String?
  /// The social account the person authorized publishing to.
  authorizedAccountId String?
  dispatchState       DispatchState       @default(NONE)
  dispatchAttempts    Int                 @default(0)
  /// Idempotency key of the hand-off: `${id}:${version}:${scheduledAt epoch}`.
  dispatchKey         String?             @unique
  lockedUntil         DateTime?           @db.Timestamptz(3)
  dispatchedAt        DateTime?           @db.Timestamptz(3)
  lastError           String?
  reminderSentAt      DateTime?           @db.Timestamptz(3)
  createdById         String?
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?           @db.Timestamptz(3)

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  content          Content?          @relation(fields: [contentId], references: [id], onDelete: SetNull)
  plan             ContentPlan?      @relation(fields: [planId], references: [id], onDelete: SetNull)
  recurrence       RecurrenceRule?   @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  socialAccount    SocialAccount?    @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  publications     Publication[]
  approvals        ApprovalRecord[]
  campaignContents CampaignContent[]

  @@unique([recurrenceId, occurrenceDate])
  @@index([businessId, scheduledAt])
  @@index([contentId])
  @@index([dispatchState, scheduledAt])
  @@index([planId])
}

/// A reviewed AI 30-day plan that was applied to the calendar.
/// A pending OAuth connection: from the redirect to the platform until the person has chosen which accounts to connect.
/// Only a hash of the state is stored; tokens and the PKCE verifier are encrypted.
model SocialConnectionSession {
  id                 String         @id @default(cuid())
  businessId         String
  userId             String
  platform           SocialPlatform
  stateHash          String         @unique
  codeVerifierEnc    String?
  /// When set, this connection renews an existing account instead of adding one.
  reconnectAccountId String?
  /// Which way of connecting the platform was chosen (LinkedIn: personal or organization). Null = the platform has one way only.
  variant            String?
  /// PENDING_AUTH → AWAITING_SELECTION → COMPLETED, or FAILED / EXPIRED.
  status             String         @default("PENDING_AUTH")
  /// Accounts the person can connect: public details plus the encrypted tokens of each.
  candidates         Json?
  error              String?
  expiresAt          DateTime       @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  completedAt        DateTime?      @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([expiresAt])
}

model ContentPlan {
  id           String   @id @default(cuid())
  businessId   String
  /// The AI generation this plan came from; unique so applying twice cannot duplicate the plan.
  generationId String?  @unique
  name         String
  startDate    String
  days         Int
  timezone     String
  language     String
  summary      String?
  itemCount    Int
  createdById  String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  events   CalendarEvent[]

  @@index([businessId, createdAt])
}

/// A recurring schedule (for example every Monday 09:00). Occurrences are materialised as calendar entries.
model RecurrenceRule {
  id          String              @id @default(cuid())
  businessId  String
  platform    SocialPlatform
  title       String
  brief       String?
  pillar      ContentPillar?
  frequency   RecurrenceFrequency
  /// 0 = Sunday … 6 = Saturday (WEEKLY only).
  weekdays    Int[]
  /// Local wall-clock time, HH:mm in `timezone`.
  localTime   String
  timezone    String
  startDate   String
  endDate     String
  active      Boolean             @default(true)
  createdById String?
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  events   CalendarEvent[]

  @@index([businessId, active])
}

/// Append-only record of every approval-workflow decision (who, what version, when).
model ApprovalRecord {
  id              String           @id @default(cuid())
  businessId      String
  contentId       String
  calendarEventId String?
  /// Content.version the decision applies to.
  version         Int
  decision        ApprovalDecision
  actorId         String?
  note            String?
  /// Snapshot of exactly what was approved or authorized (Phase N18): hash of the content, target account, media, schedule.
  snapshotHash    String?
  platform        SocialPlatform?
  socialAccountId String?
  mediaIds        String[]         @default([])
  scheduledAt     DateTime?        @db.Timestamptz(3)
  timezone        String?
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([calendarEventId, createdAt])
  @@index([contentId])
}

/// One publication attempt-set of a content item to one social account.
/// idempotencyKey guarantees the same content is never published twice to the same account for the same slot.
model Publication {
  id                  String            @id @default(cuid())
  businessId          String
  contentId           String
  socialAccountId     String
  calendarEventId     String?
  platform            SocialPlatform
  mode                PublishMode       @default(API)
  status              PublicationStatus @default(PENDING)
  scheduledAt         DateTime          @db.Timestamptz(3)
  timezone            String
  idempotencyKey      String            @unique
  /// True when the platform was the test simulator: nothing was posted anywhere (never shown as a real publication).
  simulated           Boolean           @default(false)
  jobId               String?
  attempts            Int               @default(0)
  lockedUntil         DateTime?         @db.Timestamptz(3)
  /// Set only from a provider response. Presence = provider confirmed the post exists.
  externalPostId      String?
  externalUrl         String?
  providerResponse    Json?
  lastError           String?
  errorCode           String?
  /// Provider-side handle of an in-flight step (media container id, upload session id, publish id).
  providerRef         String?
  /// The last step that was completed at the provider; a retry resumes after it instead of starting over.
  providerStage       String?
  /// Set just before the request that creates the post is sent. A crash after this point with no external id means the outcome is unknown.
  submitStartedAt     DateTime?         @db.Timestamptz(3)
  /// True when the post may or may not exist on the platform. Never retried automatically.
  outcomeUnknown      Boolean           @default(false)
  /// True only when the platform itself confirmed the post.
  confirmedByProvider Boolean           @default(false)
  /// Last reconciliation against the platform for an unknown outcome: FOUND, NOT_FOUND, AMBIGUOUS, UNAVAILABLE.
  /// The platform published with less visibility than requested (for example a YouTube upload locked to private). Shown to the person.
  visibilityNote      String?
  reconcileResult     String?
  reconcileNote       String?
  reconcileAttempts   Int               @default(0)
  reconciledAt        DateTime?         @db.Timestamptz(3)
  /// True when the platform confirmed the post by listing it after an unknown outcome (as opposed to its create response).
  reconciledFound     Boolean           @default(false)
  manualCompletedById String?
  /// What was sent: caption, hashtags, format and media ids at the time of publication.
  payload             Json?
  nextCheckAt         DateTime?         @db.Timestamptz(3)
  publishedAt         DateTime?         @db.Timestamptz(3)
  cancelledAt         DateTime?         @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  content            Content             @relation(fields: [contentId], references: [id], onDelete: Cascade)
  socialAccount      SocialAccount       @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  calendarEvent      CalendarEvent?      @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  comments           Comment[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@unique([socialAccountId, externalPostId])
  @@index([businessId, status])
  @@index([status, scheduledAt])
  @@index([contentId])
  @@index([status, nextCheckAt])
}

// ─────────────────────────────── Inbox ───────────────────────────────

model Conversation {
  id                 String              @id @default(cuid())
  businessId         String
  socialAccountId    String?
  channel            ConversationChannel
  externalThreadId   String?
  customerExternalId String?
  customerName       String?
  status             ConversationStatus  @default(OPEN)
  escalated          Boolean             @default(false)
  escalationReason   EscalationReason?
  assignedToId       String?
  customerId         String?
  /// Detected language of the customer (en, fr, tr, ar).
  language           String?
  aiMode             AgentMode           @default(AI_ACTIVE)
  /// A conversation started from the dashboard playground: never counted as a real lead.
  isTest             Boolean             @default(false)
  /// SHA-256 of the secret the customer's browser holds; the only way a public visitor can read or continue this conversation.
  publicTokenHash    String?             @unique
  intent             String?
  purchaseIntent     PurchaseIntent      @default(NONE)
  handoffReason      String?
  handoffRequestedAt DateTime?           @db.Timestamptz(3)
  humanTakeoverById  String?
  aiRepliesCount     Int                 @default(0)
  lastMessageAt      DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount?     @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  customer      Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages      Message[]
  notes         CustomerNote[]
  qualification LeadQualification?
  handoffs      SalesHandoff[]
  followUps     SalesFollowUp[]
  feedback      AgentFeedback[]

  @@unique([socialAccountId, externalThreadId])
  @@index([businessId, status, lastMessageAt])
  @@index([businessId, customerId])
  @@index([businessId, aiMode])
}

model Message {
  id                String              @id @default(cuid())
  businessId        String
  conversationId    String
  direction         MessageDirection
  authorType        MessageAuthorType
  authorUserId      String?
  body              String
  externalMessageId String?
  approvalStatus    ReplyApprovalStatus @default(NOT_REQUIRED)
  escalationReason  EscalationReason?
  language          String?
  intent            String?
  /// AI replies: confidence, sources, recommended items, handoff, model, prompt version. Never secrets or other businesses' data.
  aiMetadata        Json?
  sentAt            DateTime?           @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorUser   User?           @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  feedback     AgentFeedback[]

  @@unique([conversationId, externalMessageId])
  @@index([businessId, createdAt])
  @@index([conversationId, createdAt])
}

model Comment {
  id                String              @id @default(cuid())
  businessId        String
  socialAccountId   String
  publicationId     String?
  externalCommentId String
  parentId          String?
  authorExternalId  String?
  authorName        String?
  body              String
  isFromBusiness    Boolean             @default(false)
  hidden            Boolean             @default(false)
  approvalStatus    ReplyApprovalStatus @default(NOT_REQUIRED)
  postedAt          DateTime?           @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  publication   Publication?  @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  parent        Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]     @relation("CommentReplies")

  @@unique([socialAccountId, externalCommentId])
  @@index([businessId, createdAt])
  @@index([publicationId])
}

/// A person who talks to the business's agent. Identified only by what they chose to share; erasable.
model Customer {
  id                     String              @id @default(cuid())
  businessId             String
  name                   String?
  email                  String?
  phone                  String?
  language               String?
  source                 ConversationChannel @default(WEB_CHAT)
  leadStatus             LeadStatus          @default(NEW)
  purchaseIntent         PurchaseIntent      @default(NONE)
  lastIntent             String?
  /// Items the customer showed interest in: "product:<id>" / "service:<id>".
  interests              String[]
  /// Set when the customer explicitly agreed to be contacted.
  consentAt              DateTime?           @db.Timestamptz(3)
  assignedToId           String?
  followUpAt             DateTime?           @db.Timestamptz(3)
  firstSeenAt            DateTime            @default(now()) @db.Timestamptz(3)
  lastSeenAt             DateTime            @default(now()) @db.Timestamptz(3)
  /// Personal data was erased at the customer's or merchant's request.
  /// Phase N5: follow-up messages need this explicit consent (separate from storing contact details) and stop at an opt-out.
  followUpConsentAt      DateTime?           @db.Timestamptz(3)
  optedOutAt             DateTime?           @db.Timestamptz(3)
  /// Phase N5: a conversion counts only when a person marked the customer WON (never the AI).
  conversionVerifiedAt   DateTime?           @db.Timestamptz(3)
  conversionVerifiedById String?
  anonymizedAt           DateTime?           @db.Timestamptz(3)
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  notes         CustomerNote[]

  @@index([businessId, leadStatus])
  @@index([businessId, lastSeenAt])
  @@index([businessId, email])
  @@index([businessId, phone])
}

/// Internal note about a customer or one conversation. Never shown to the customer and never given to the AI.
model CustomerNote {
  id             String   @id @default(cuid())
  businessId     String
  customerId     String
  conversationId String?
  authorId       String?
  body           String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  author       User?         @relation("CustomerNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([businessId, customerId])
}

/// One agent configuration per business. The agent is OFF until a person turns it on.
model SalesAgentConfig {
  id                          String         @id @default(cuid())
  businessId                  String         @unique
  enabled                     Boolean        @default(false)
  name                        String         @default("TOUMA Assistant")
  /// Languages the agent answers in (subset of en, fr, tr, ar).
  languages                   String[]       @default(["en", "fr"])
  defaultLanguage             String         @default("en")
  tone                        String?
  greeting                    String?
  handoffMessage              String?
  replyMode                   AgentReplyMode @default(REVIEW)
  /// Who allowed the AI to answer customers without per-message review, and when.
  autoReplyAuthorizedById     String?
  autoReplyAuthorizedAt       DateTime?      @db.Timestamptz(3)
  maxAiRepliesPerConversation Int            @default(30)
  /// In AUTO mode the AI answers by itself only at or above this confidence (HIGH, or MEDIUM); below it the reply is a draft for a person.
  autoMinConfidence           String         @default("HIGH")
  /// Link to the merchant's privacy policy, shown in the customer chat next to TOUMA's short notice.
  privacyNoticeUrl            String?
  /// Customer conversations and personal data are erased after this many days without activity.
  retentionDays               Int            @default(365)
  updatedById                 String?
  createdAt                   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime       @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

/// A person flagged an AI reply as inaccurate and said what is correct.
model AgentFeedback {
  id               String         @id @default(cuid())
  businessId       String
  conversationId   String
  messageId        String
  reporterId       String?
  /// What was wrong, and the correct information.
  note             String
  correction       String?
  status           FeedbackStatus @default(OPEN)
  knowledgeEntryId String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  resolvedAt       DateTime?      @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([conversationId])
}

// ─────────────────────────────── Billing ───────────────────────────────

model Plan {
  id              String          @id @default(cuid())
  code            PlanCode        @unique
  name            String
  description     String?
  priceAmount     Decimal         @db.Decimal(12, 2)
  currency        String          @default("USD")
  interval        BillingInterval @default(MONTH)
  /// Payment-provider price identifier (e.g. Stripe price id). Null = not configured with provider.
  providerPriceId String?         @unique
  /// Limits e.g. { "businesses": 1, "socialAccounts": 3, "aiCreditsPerMonth": 200, "seats": 2 }
  limits          Json
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  businessId             String             @unique
  planId                 String
  status                 SubscriptionStatus @default(INCOMPLETE)
  provider               String             @default("stripe")
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  currentPeriodStart     DateTime?          @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?          @db.Timestamptz(3)
  trialEndsAt            DateTime?          @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([status])
  @@index([providerCustomerId])
}

/// No card data is ever stored. Only provider references and amounts.
model Payment {
  id                String        @id @default(cuid())
  businessId        String
  subscriptionId    String?
  provider          String        @default("stripe")
  providerPaymentId String        @unique
  providerInvoiceId String?
  amount            Decimal       @db.Decimal(12, 2)
  amountRefunded    Decimal       @default(0) @db.Decimal(12, 2)
  currency          String
  status            PaymentStatus
  description       String?
  invoiceUrl        String?
  paidAt            DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
}

// ─────────────────────────────── Analytics ───────────────────────────────

model AnalyticsSnapshot {
  id              String         @id @default(cuid())
  businessId      String
  socialAccountId String?
  publicationId   String?
  platform        SocialPlatform
  period          SnapshotPeriod
  periodStart     DateTime       @db.Timestamptz(3)
  periodEnd       DateTime       @db.Timestamptz(3)
  source          MetricSource   @default(MEASURED)
  /// Null = metric not available from provider (never zero-filled).
  reach           Int?
  impressions     Int?
  views           Int?
  likes           Int?
  comments        Int?
  shares          Int?
  saves           Int?
  linkClicks      Int?
  engagementRate  Decimal?       @db.Decimal(8, 4)
  followers       Int?
  raw             Json?
  fetchedAt       DateTime       @default(now()) @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  publication   Publication?   @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, publicationId, period, periodStart, source])
  @@index([businessId, periodStart])
  @@index([publicationId])
}

// ─────────────────────────────── Platform ───────────────────────────────

model Notification {
  id         String              @id @default(cuid())
  userId     String
  businessId String?
  channel    NotificationChannel @default(IN_APP)
  type       String
  title      String
  body       String?
  data       Json?
  /// Prevents sending the same notification twice (unique per user).
  dedupeKey  String?
  readAt     DateTime?           @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

/// Append-only security & business audit trail. Never store secrets or tokens in metadata.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  businessId String?
  action     String // e.g. auth.login, auth.login_failed, business.create
  entityType String?
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor    User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

/// Inbound provider webhooks. (provider, externalEventId) unique => idempotent processing.
model WebhookEvent {
  id              String          @id @default(cuid())
  provider        WebhookProvider
  externalEventId String
  type            String
  signatureValid  Boolean
  status          WebhookStatus   @default(RECEIVED)
  payload         Json
  error           String?
  attempts        Int             @default(0)
  receivedAt      DateTime        @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?       @db.Timestamptz(3)

  @@unique([provider, externalEventId])
  @@index([status, receivedAt])
}

model AIUsage {
  id           String   @id @default(cuid())
  businessId   String
  userId       String?
  agent        AIAgent
  provider     String
  model        String
  operation    String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  imageCount   Int      @default(0)
  videoSeconds Decimal  @default(0) @db.Decimal(10, 3)
  credits      Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(12, 6)
  success      Boolean  @default(true)
  error        String?
  latencyMs    Int?
  generationId String?
  /// initial | provider-retry | repair
  attemptKind  String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  generation AIGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([agent, createdAt])
  @@index([generationId])
}

/// One user-level AI request (analysis, strategy or content), with its validated output.
/// Provider calls (including retries and repairs) are itemised in AIUsage.
model AIGeneration {
  id             String             @id @default(cuid())
  businessId     String
  userId         String?
  task           AITask
  status         AIGenerationStatus
  /// Product or service the generation is about (null for business-wide tasks).
  itemType       String?
  itemId         String?
  platform       String?
  format         String?
  language       String
  tone           String?
  purpose        String?
  /// Validated request parameters (enums and ids only; user instructions stored separately).
  params         Json
  instructions   String?
  /// Validated, schema-conforming output. Null when the generation failed.
  output         Json?
  /// Output after human edits (save draft). The original output is kept for traceability.
  editedOutput   Json?
  errorCode      String?
  errorMessage   String?
  provider       String
  model          String
  promptVersion  String
  /// Hash of the business facts used; lets analyses be reused while the data is unchanged.
  contextHash    String
  injectionFlags String[]
  inputTokens    Int                @default(0)
  outputTokens   Int                @default(0)
  costUsd        Decimal            @default(0) @db.Decimal(12, 6)
  latencyMs      Int                @default(0)
  attempts       Int                @default(0)
  parentId       String?
  contentId      String?            @unique
  /// Job this row belongs to: its own id for the generation the user requested, the requested
  /// generation's id for the analyses it triggered. Settlement accounts for all rows of one job.
  rootId         String?
  /// Pipeline progress (context, analyses, generation, validation, save).
  steps          Json?
  /// Grounding report: checks run, facts verified against the business data, issues.
  quality        Json?
  /// BullMQ attempts made so far (0 for rows that were not queued).
  jobAttempts    Int                @default(0)
  queuedAt       DateTime?          @db.Timestamptz(3)
  startedAt      DateTime?          @db.Timestamptz(3)
  completedAt    DateTime?          @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)

  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent      AIGeneration?  @relation("Regeneration", fields: [parentId], references: [id], onDelete: SetNull)
  children    AIGeneration[] @relation("Regeneration")
  content     Content?       @relation(fields: [contentId], references: [id], onDelete: SetNull)
  usages      AIUsage[]
  reservation AIReservation?

  @@index([businessId, createdAt])
  @@index([businessId, task, status, createdAt])
  @@index([businessId, task, itemId, contextHash])
  @@index([rootId])
  @@index([status, queuedAt])
}

/// Monthly AI usage counters per business (UTC month). Limits are enforced by an atomic conditional
/// UPDATE on this row, so concurrent requests cannot overshoot: reserved + completed + failed <= limit.
model AIUsagePeriod {
  id                    String   @id @default(cuid())
  businessId            String
  periodStart           DateTime @db.Timestamptz(3)
  /// Units held by queued/running jobs.
  reservedGenerations   Int      @default(0)
  completedGenerations  Int      @default(0)
  failedGenerations     Int      @default(0)
  /// Cumulative reserved units that were released unused (informational).
  releasedGenerations   Int      @default(0)
  reservedTokens        Int      @default(0)
  usedTokens            Int      @default(0)
  /// Creative Studio: images and video seconds, reserved while a job is queued/running and settled when it ends.
  reservedImages        Int      @default(0)
  completedImages       Int      @default(0)
  reservedVideoSeconds  Int      @default(0)
  completedVideoSeconds Int      @default(0)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, periodStart])
}

/// Quota held for one queued generation job until it is settled (committed or released).
model AIReservation {
  id             String              @id @default(cuid())
  businessId     String
  generationId   String              @unique
  periodStart    DateTime            @db.Timestamptz(3)
  units          Int
  tokens         Int
  status         AIReservationStatus @default(RESERVED)
  consumedUnits  Int                 @default(0)
  consumedTokens Int                 @default(0)
  /// succeeded | failed | released | reconciled
  outcome        String?
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  settledAt      DateTime?           @db.Timestamptz(3)

  generation AIGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([businessId, periodStart])
}

/// Single-use, expiring tokens for email verification and password reset. Only a SHA-256 hash is stored.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  /// Address the token was sent to (verification is bound to it).
  email     String
  expiresAt DateTime      @db.Timestamptz(3)
  usedAt    DateTime?     @db.Timestamptz(3)
  ipAddress String?
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@index([expiresAt])
}

/// Email invitation to join a business. The token (hashed) proves control of the invited address.
model Invitation {
  id           String       @id @default(cuid())
  businessId   String
  email        String
  role         BusinessRole
  tokenHash    String       @unique
  invitedById  String?
  expiresAt    DateTime     @db.Timestamptz(3)
  acceptedAt   DateTime?    @db.Timestamptz(3)
  acceptedById String?
  revokedAt    DateTime?    @db.Timestamptz(3)
  sendCount    Int          @default(1)
  lastSentAt   DateTime     @default(now()) @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy  User?    @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User?    @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([businessId, email])
  @@index([businessId, acceptedAt, revokedAt])
}

/// Durable queue of storage objects to delete. Deletions that fail are retried by the worker
/// with backoff, so a temporary storage outage never leaves orphaned files behind.
model StorageDeletion {
  id            String    @id @default(cuid())
  businessId    String?
  storageKey    String
  reason        String
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(3)
  completedAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([completedAt, nextAttemptAt])
  @@index([storageKey])
}

/// Brand identity of one business, applied to generated images, videos and text. The logo itself is the business's
/// existing logo (Business.logoMediaId), so there is one source of truth.
model BrandKit {
  id            String   @id @default(cuid())
  businessId    String   @unique
  /// [{ name, hex: "#RRGGBB", role: PRIMARY | SECONDARY | ACCENT | BACKGROUND | TEXT }]
  colors        Json     @default("[]")
  headingFont   String?
  bodyFont      String?
  /// One of the image styles (e.g. LUXURY), used as the default look of generated visuals.
  visualStyle   String?
  guidelines    String?
  /// One of the AI tones (e.g. FRIENDLY): the preferred marketing tone for generated text.
  preferredTone String?
  updatedById   String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

/// One image or video request of the Creative Studio and its background job. Units (images, video seconds) are
/// reserved atomically against the monthly limits when the request is accepted and settled exactly once.
model CreativeGeneration {
  id             String         @id @default(cuid())
  businessId     String
  userId         String?
  kind           CreativeKind
  status         CreativeStatus @default(QUEUED)
  provider       String
  model          String
  /// The prompt sent to the provider (built by TOUMA from verified facts and the brand kit; never contains secrets).
  prompt         String
  /// Validated request: type, style, aspect ratio, resolution, background, theme, overlay, platform, preservation...
  params         Json
  /// Client-supplied key making the submission idempotent; requestHash detects a key reused with different parameters.
  idempotencyKey String?
  requestHash    String?
  itemType       String?
  itemId         String?
  /// The merchant's original product photo (a MediaAsset of this business).
  sourceMediaId  String?
  /// Generation this one is a variation of.
  parentId       String?
  brandSnapshot  Json?
  /// Provider-side job id (video); recorded once so a retry never submits (and pays for) the job twice.
  providerRef    String?
  providerStatus String?
  requestedUnits Int
  /// Units the provider actually produced (billed), whether or not they could all be stored.
  producedUnits  Int            @default(0)
  reservedUnits  Int
  /// IMAGE | VIDEO_SECOND
  unitKind       String
  periodStart    DateTime       @db.Timestamptz(3)
  settledAt      DateTime?      @db.Timestamptz(3)
  errorCode      String?
  errorMessage   String?
  inputTokens    Int            @default(0)
  outputTokens   Int            @default(0)
  costUsd        Decimal        @default(0) @db.Decimal(12, 6)
  processingMs   Int            @default(0)
  jobAttempts    Int            @default(0)
  pollCount      Int            @default(0)
  queuedAt       DateTime?      @db.Timestamptz(3)
  startedAt      DateTime?      @db.Timestamptz(3)
  completedAt    DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outputs  CreativeOutput[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, kind, createdAt])
  @@index([status, queuedAt])
  @@index([settledAt, status])
}

/// A stored result of a creative generation (an image or a video), kept in the media library as a MediaAsset.
model CreativeOutput {
  id            String   @id @default(cuid())
  generationId  String
  businessId    String
  mediaId       String
  index         Int
  width         Int?
  height        Int?
  /// EXACT | GUIDED | NONE: how the original product appearance was preserved.
  preservation  String?
  /// true when the provider rendered fewer pixels than requested and the result was resized up.
  upscaled      Boolean  @default(false)
  revisedPrompt String?
  /// The merchant's pick among the variations.
  selected      Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  generation CreativeGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  media      MediaAsset         @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([generationId, index])
  @@index([businessId, mediaId])
}

// ─────────────────────────── AI Orchestrator MVP ───────────────────────────
// A run is a small plan of steps with dependencies, executed by BullMQ workers. Phase N2 ships simulated adapters only:
// no real model call and no external action. Steps that act outside TOUMA must wait for a human approval.

enum AgentRunStatus {
  PENDING
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  /// Phase N3: no new step starts until resumed.
  PAUSED
  /// Phase N3: stopped by a person; final.
  CANCELLED
}

enum AgentRunStepStatus {
  PENDING
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  /// Phase N3: its condition was false, so it did not run (counts as satisfied for the steps that depend on it).
  SKIPPED
  CANCELLED
}

model AgentRun {
  id              String         @id @default(cuid())
  businessId      String
  /// Requesting user (id only; no relation so deleting a user never touches the history).
  createdById     String?
  template        String
  templateVersion Int
  status          AgentRunStatus @default(PENDING)
  /// Client-supplied key: the same key with the same request returns the same run; with another request it is refused.
  idempotencyKey  String
  /// SHA-256 of the canonical request, to detect a key reused with a different payload.
  requestHash     String
  /// Validated, size-limited business input. Never contains credentials.
  input           Json
  errorCode       String?
  errorMessage    String?
  /// Phase N3: set when the run comes from a workflow (definition id and the immutable version it started from).
  workflowId      String?
  workflowVersion Int?
  /// manual | schedule | event
  triggerType     String?
  /// Validated, size-limited scalars of the triggering event (conditions can read them as `trigger.*`).
  triggerData     Json?
  /// Set when the run failed and waits for a person (the dead-letter list); cleared by a retry.
  deadLetteredAt  DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  startedAt       DateTime?      @db.Timestamptz(3)
  completedAt     DateTime?      @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  steps    AgentRunStep[]
  events   AgentRunEvent[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, status, createdAt])
  @@index([status, updatedAt])
  @@index([businessId, workflowId, createdAt])
  @@index([businessId, deadLetteredAt])
}

model AgentRunStep {
  id               String             @id @default(cuid())
  runId            String
  /// Denormalised so every step query can be scoped by tenant.
  businessId       String
  key              String
  adapter          String
  dependsOn        String[]
  requiresApproval Boolean            @default(false)
  status           AgentRunStepStatus @default(PENDING)
  attempts         Int                @default(0)
  maxAttempts      Int
  nextAttemptAt    DateTime?          @db.Timestamptz(3)
  /// Restricted condition (see workflow-conditions.ts); false means the step is SKIPPED.
  condition        Json?
  /// Per-step retry policy (null: the environment default).
  backoffMs        Int?
  output           Json?
  errorCode        String?
  errorMessage     String?
  /// APPROVED | REJECTED, with who decided and when.
  approvalDecision String?
  decidedById      String?
  decidedAt        DateTime?          @db.Timestamptz(3)
  startedAt        DateTime?          @db.Timestamptz(3)
  completedAt      DateTime?          @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, key])
  @@index([businessId, status])
  @@index([status, startedAt])
}

/// Append-only history of a run. `detail` holds codes and counters only, never business input or credentials.
model AgentRunEvent {
  id         String   @id @default(cuid())
  runId      String
  businessId String
  stepKey    String?
  type       String
  actorId    String?
  detail     Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([businessId, createdAt])
}

// ─────────────────────────── Workflow engine (Phase N3) ───────────────────────────
// A definition has immutable versions; an execution is an AgentRun that snapshots the version it started from.

model WorkflowDefinition {
  id             String    @id @default(cuid())
  businessId     String
  name           String
  description    String?
  /// Latest version number: new executions start from it; running ones keep their own snapshot.
  currentVersion Int
  isActive       Boolean   @default(false)
  /// The user whose permissions scheduled and event-triggered executions run with.
  activatedById  String?
  /// Next scheduled execution (schedule trigger), claimed with one conditional UPDATE.
  nextRunAt      DateTime? @db.Timestamptz(3)
  createdById    String
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  versions WorkflowVersion[]

  @@unique([businessId, name])
  @@index([isActive, nextRunAt])
  @@index([businessId, isActive])
}

model WorkflowVersion {
  id          String   @id @default(cuid())
  workflowId  String
  businessId  String
  version     Int
  /// The validated definition document (never contains secrets or code).
  definition  Json
  createdById String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  workflow WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@index([businessId])
}

// ─────────────────────────── Market intelligence (Phase N4) ───────────────────────────
// A product researched for a target market, entered by a person from a source they name (Phase N4 has no data provider
// and no scraper). Nothing is inferred: a number that was not supplied stays NULL and is reported as UNKNOWN.

model MarketProduct {
  id                    String   @id @default(cuid())
  businessId            String
  createdById           String?
  name                  String
  /// Lower-case, accent-free, punctuation-free name; with the market and supplier it forms the duplicate key.
  normalizedName        String
  dedupeKey             String
  category              String?
  /// Target market, ISO 3166-1 alpha-2.
  country               String
  supplierName          String?
  /// Provenance: MANUAL for now. `sourceUrl` is only stored and shown, never fetched.
  sourceType            String   @default("MANUAL")
  sourceName            String?
  sourceUrl             String
  sourceUrlKey          String
  /// When the figures were true at the source (set by the person, not by the server).
  observedAt            DateTime @db.Timestamptz(3)
  /// Supplier-side amounts (unit cost and shipping per unit), in `costCurrency`.
  costCurrency          String
  unitCost              Decimal? @db.Decimal(14, 2)
  shippingCost          Decimal? @db.Decimal(14, 2)
  /// The planned or observed selling price in the target market, in `sellingCurrency`.
  sellingCurrency       String
  sellingPrice          Decimal? @db.Decimal(14, 2)
  estimatedDeliveryDays Int?
  supplierRating        Decimal? @db.Decimal(3, 2)
  supplierRatingSource  String?
  monthlySearches       Int?
  demandSource          String?
  competitorCount       Int?
  competitorSource      String?
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  analyses MarketAnalysis[]

  @@unique([businessId, dedupeKey])
  @@index([businessId, country, createdAt])
  @@index([businessId, sourceUrlKey])
}

/// One research run: the assumptions used and the deterministic results, kept as history. Same inputs and `asOf` give the same results.
model MarketAnalysis {
  id            String   @id @default(cuid())
  businessId    String
  productId     String
  createdById   String?
  modelVersion  String
  /// The instant freshness was measured against (stored so a result can be reproduced).
  asOf          DateTime @db.Timestamptz(3)
  assumptions   Json
  profitability Json
  score         Json
  quality       Json
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  product MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([businessId, createdAt])
}

// ─────────────────────────── Sales assistant 2.0 (Phase N5) ───────────────────────────
// Explainable lead qualification, handoff records with a factual summary, and follow-up drafts that need consent and a
// person's authorization. Nothing here sends a message: there is no outbound channel.

enum SalesHandoffStatus {
  REQUESTED
  ACCEPTED
  RESOLVED
  CANCELLED
}

enum SalesFollowUpStatus {
  /// Prepared; waiting for a person.
  SUGGESTED
  /// A person authorised it. Phase N5 has no channel to send it through.
  APPROVED
  REJECTED
  /// Could not be prepared or released (no consent, opted out, erased).
  BLOCKED
}

/// Rule-based qualification of one conversation: a 0-100 score built from named rules, each with its points and evidence.
model LeadQualification {
  id                String   @id @default(cuid())
  businessId        String
  conversationId    String   @unique
  customerId        String?
  score             Int
  /// UNKNOWN | COLD | WARM | HOT: a summary of the rules that fired, not a prediction.
  level             String
  /// What the customer volunteered (budget, quantity, urgency, preferences, interests). Erased with the conversation.
  signals           Json
  reasons           Json
  modelVersion      String
  evaluatedMessages Int
  computedAt        DateTime @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([businessId, level])
}

model SalesHandoff {
  id             String             @id @default(cuid())
  businessId     String
  conversationId String
  customerId     String?
  status         SalesHandoffStatus @default(REQUESTED)
  reason         String
  /// AI | CUSTOMER | STAFF
  requestedBy    String
  /// Factual summary compiled from stored data (no model text). Erased with the conversation; the record stays for statistics.
  summary        Json?
  requestedAt    DateTime           @default(now()) @db.Timestamptz(3)
  acceptedById   String?
  acceptedAt     DateTime?          @db.Timestamptz(3)
  resolvedById   String?
  resolvedAt     DateTime?          @db.Timestamptz(3)
  resolutionNote String?
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([businessId, status, requestedAt])
  @@index([conversationId, status])
}

model SalesFollowUp {
  id             String              @id @default(cuid())
  businessId     String
  conversationId String
  customerId     String
  status         SalesFollowUpStatus @default(SUGGESTED)
  language       String
  /// Built from a template and verified catalog names only: no price, no discount, no promise.
  suggestedText  String
  basis          Json
  blockedReason  String?
  /// STAFF | WORKFLOW
  source         String
  createdById    String?
  decidedById    String?
  decidedAt      DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([businessId, status, createdAt])
  @@index([conversationId])
}

// ── Operations control center (Phase N6) ──────────────────────────────────────────────────────────────────────────────
// Platform-level operational telemetry. No tenant data: queues are identified by name only (a fixed, small set).

enum OpsAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// One reading of a BullMQ queue's job counts (real telemetry, sampled on a schedule). Bounded by retention.
model OpsQueueSample {
  id         String   @id @default(cuid())
  queue      String
  capturedAt DateTime @default(now()) @db.Timestamptz(3)
  waiting    Int
  active     Int
  delayed    Int
  failed     Int
  completed  Int

  @@index([queue, capturedAt])
  @@index([capturedAt])
}

/// A configurable threshold: alert when a queue has at least `threshold` failed jobs. queue = null applies to each queue.
model OpsAlertRule {
  id          String   @id @default(cuid())
  kind        String   @default("QUEUE_FAILED")
  queue       String?
  threshold   Int
  enabled     Boolean  @default(true)
  updatedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  alerts OpsAlert[]

  @@unique([kind, queue])
}

/// An alert instance. `dedupeKey` is set only while the alert is open or acknowledged, so a condition that persists
/// updates one alert instead of creating a new one each time it is sampled.
model OpsAlert {
  id             String         @id @default(cuid())
  ruleId         String
  queue          String
  status         OpsAlertStatus @default(OPEN)
  dedupeKey      String?        @unique
  observed       Int
  threshold      Int
  occurrences    Int            @default(1)
  firstSeenAt    DateTime       @default(now()) @db.Timestamptz(3)
  lastSeenAt     DateTime       @default(now()) @db.Timestamptz(3)
  acknowledgedAt DateTime?      @db.Timestamptz(3)
  acknowledgedBy String?
  resolvedAt     DateTime?      @db.Timestamptz(3)
  resolvedBy     String?
  resolution     String?

  rule OpsAlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([status, lastSeenAt])
}

// ─────────────────────────── Campaign engine (Phase N20) ───────────────────────────
// A campaign groups products and the calendar entries drafted for them. It owns NO approval state: every post is an ordinary
// CalendarEvent that goes through the N18 individual approval. Metrics are read from AnalyticsSnapshot through the publication.

enum CampaignStatus {
  DRAFT
  PLANNED
  CONTENT_READY
  AWAITING_APPROVAL
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AgentExecutionStatus {
  SUCCEEDED
  FAILED
  TIMED_OUT
  REFUSED
}

model Campaign {
  id              String         @id @default(cuid())
  businessId      String
  name            String
  /// { type: AWARENESS | ENGAGEMENT | TRAFFIC | LAUNCH, description?: string } (validated in code).
  goal            Json
  status          CampaignStatus @default(DRAFT)
  /// Immediate kill switch: while true no agent runs and nothing new is drafted.
  paused          Boolean        @default(false)
  /// Execution budget. Mock providers cost nothing; costLimitMicros stays 0 (USD millionths) until paid generation is authorized.
  executionLimit  Int            @default(20)
  executionsUsed  Int            @default(0)
  costLimitMicros Int            @default(0)
  costUsedMicros  Int            @default(0)
  /// Structured plan written by the planning agents (positioning, channels, audiences, ideas, calendar, cost estimate).
  plan            Json?
  planVersion     Int            @default(0)
  idempotencyKey  String
  createdById     String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products   CampaignProduct[]
  contents   CampaignContent[]
  executions AgentExecution[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, status, createdAt])
}

model CampaignProduct {
  id         String   @id @default(cuid())
  campaignId String
  businessId String
  productId  String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([businessId, productId])
}

/// Links a campaign to a calendar entry (which holds the Content and its approval). Never stores approval state itself.
model CampaignContent {
  id              String   @id @default(cuid())
  campaignId      String
  businessId      String
  calendarEventId String
  productId       String?
  /// INITIAL, or FOLLOW_UP when the performance agent proposed it.
  kind            String   @default("INITIAL")
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  campaign      Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  calendarEvent CalendarEvent @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)

  @@unique([campaignId, calendarEventId])
  @@index([businessId, campaignId])
}

/// One run of one agent: what it was allowed to do, what it cost, how it ended. Output holds structured data only.
model AgentExecution {
  id             String               @id @default(cuid())
  businessId     String
  campaignId     String
  agent          String
  status         AgentExecutionStatus
  /// Same key = same execution (replay returns it, no second run).
  idempotencyKey String
  attempts       Int                  @default(1)
  inputHash      String
  output         Json?
  errorCode      String?
  costMicros     Int                  @default(0)
  durationMs     Int?
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, idempotencyKey])
  @@index([businessId, createdAt])
  @@index([campaignId, agent])
}
