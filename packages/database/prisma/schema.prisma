// TOUMA - database schema
// Conventions:
//  - All ids are cuid strings. All timestamps are stored in UTC (timestamptz).
//  - Every tenant-scoped table carries businessId and is indexed on it.
//  - Money is Decimal(12,2) with an explicit ISO-4217 currency column.
//  - Secrets (OAuth tokens) are stored ONLY as AES-256-GCM ciphertext (*Enc columns).
//  - Soft deletion uses deletedAt on user-facing entities.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum PlatformRole {
  USER
  SUPPORT
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
}

enum BusinessRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum BusinessType {
  ECOMMERCE
  RESTAURANT
  RETAIL_STORE
  SMALL_BUSINESS
  BRAND
  AGENCY
  FREELANCER
  SERVICE_PROVIDER
  OTHER
}

enum CatalogStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductAvailability {
  IN_STOCK
  OUT_OF_STOCK
  PREORDER
  MADE_TO_ORDER
  DISCONTINUED
}

enum ServiceAvailability {
  AVAILABLE
  BY_APPOINTMENT
  UNAVAILABLE
}

enum CategoryKind {
  PRODUCT
  SERVICE
}

enum KnowledgeCategory {
  COMPANY
  PRODUCT
  SERVICE
  PRICING
  DELIVERY_POLICY
  RETURN_POLICY
  FAQ
  CUSTOMER_SUPPORT
  OTHER
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  YOUTUBE
}

enum SocialAccountStatus {
  CONNECTED
  TOKEN_EXPIRED
  PERMISSION_MISSING
  DISCONNECTED
  ERROR
}

enum ContentType {
  TEXT
  IMAGE
  VIDEO
  CAROUSEL
  CAMPAIGN
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
  ARCHIVED
}

enum ContentOrigin {
  HUMAN
  AI_GENERATED
  AI_ASSISTED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum MediaStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  REJECTED
  FAILED
}

enum CalendarEventStatus {
  PLANNED
  CONFIRMED
  CANCELLED
  DONE
}

enum PublicationStatus {
  PENDING
  QUEUED
  PUBLISHING
  AWAITING_PROVIDER // submitted, waiting for provider confirmation (e.g. async video processing)
  PUBLISHED // confirmed by provider
  FAILED
  CANCELLED
  MANUAL_REQUIRED // platform API cannot publish this content; user must publish manually
}

enum PublishMode {
  API
  MANUAL
}

enum ConversationChannel {
  INSTAGRAM_DM
  FACEBOOK_MESSENGER
  COMMENT_THREAD
  OTHER
}

enum ConversationStatus {
  OPEN
  PENDING_HUMAN
  RESOLVED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageAuthorType {
  CUSTOMER
  HUMAN_AGENT
  AI_SUGGESTION
  SYSTEM
}

enum ReplyApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum EscalationReason {
  REFUND
  FINANCIAL_COMMITMENT
  LEGAL_COMPLAINT
  SENSITIVE_DISPUTE
  UNVERIFIED_PROMISE
  OTHER
}

enum PlanCode {
  STARTER
  PRO
  BUSINESS
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum MetricSource {
  MEASURED // returned by a platform API
  ESTIMATED // computed/estimated by AI; never shown as measured
}

enum SnapshotPeriod {
  DAY
  WEEK
  MONTH
  LIFETIME
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum WebhookProvider {
  STRIPE
  META
  TIKTOK
  YOUTUBE
  OTHER
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum AIAgent {
  BUSINESS_ANALYST
  PRODUCT_ANALYST
  MARKETING_STRATEGIST
  CONTENT_CREATOR
  VISUAL_CREATOR
  VIDEO_CREATOR
  SCHEDULER
  CUSTOMER_SUPPORT
  PERFORMANCE_ANALYST
  ORCHESTRATOR
}

enum KnowledgeSource {
  BUSINESS_PROFILE
  PRODUCT
  SERVICE
  POLICY
  FAQ
  MANUAL
}

// ─────────────────────────────── Identity ───────────────────────────────

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  passwordHash     String
  fullName         String
  locale           String       @default("en")
  timezone         String       @default("UTC")
  platformRole     PlatformRole @default(USER)
  status           UserStatus   @default(ACTIVE)
  emailVerifiedAt  DateTime?    @db.Timestamptz(3)
  lastLoginAt      DateTime?    @db.Timestamptz(3)
  failedLoginCount Int          @default(0)
  lockedUntil      DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?    @db.Timestamptz(3)

  sessions          Session[]
  memberships       Membership[]
  invitationsSent   Membership[]     @relation("MembershipInviter")
  contentsCreated   Content[]        @relation("ContentCreator")
  contentsApproved  Content[]        @relation("ContentApprover")
  mediaUploaded     MediaAsset[]
  messagesAuthored  Message[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  aiUsages          AIUsage[]
  knowledgeVerified KnowledgeEntry[] @relation("KnowledgeVerifier")

  @@index([status])
  @@index([deletedAt])
}

/// Refresh-token session. Only a SHA-256 hash of the refresh token is stored.
/// Rotation: each refresh revokes the current session token and issues a new one in the same family.
/// Reuse of a revoked token revokes the whole family (token theft detection).
model Session {
  id               String    @id @default(cuid())
  userId           String
  familyId         String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  replacedById     String?   @unique
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz(3)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy Session? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   Session? @relation("SessionRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ─────────────────────────────── Tenancy ───────────────────────────────

model Business {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  type           BusinessType @default(OTHER)
  description    String?
  website        String?
  industry       String?
  country        String? // ISO 3166-1 alpha-2
  city           String?
  address        String?
  contactEmail   String?
  contactPhone   String? // E.164 recommended, stored as entered
  defaultLocale  String       @default("en")
  /// IANA timezone used for scheduling. Timestamps remain UTC; this is the display/scheduling zone.
  timezone       String       @default("UTC")
  currency       String       @default("USD") // ISO 4217
  brandVoice     String?
  targetAudience String?
  objectives     String?
  logoMediaId    String?      @unique
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?    @db.Timestamptz(3)

  logo               MediaAsset?         @relation("BusinessLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  memberships        Membership[]
  products           Product[]
  services           Service[]
  socialAccounts     SocialAccount[]
  contents           Content[]
  mediaAssets        MediaAsset[]        @relation("BusinessMedia")
  calendarEvents     CalendarEvent[]
  publications       Publication[]
  conversations      Conversation[]
  comments           Comment[]
  subscription       Subscription?
  payments           Payment[]
  analyticsSnapshots AnalyticsSnapshot[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  aiUsages           AIUsage[]
  knowledgeEntries   KnowledgeEntry[]
  categories         Category[]

  @@index([deletedAt])
  @@index([createdAt])
}

model Membership {
  id              String           @id @default(cuid())
  userId          String
  businessId      String
  role            BusinessRole
  status          MembershipStatus @default(ACTIVE)
  invitedById     String?
  invitedEmail    String?
  inviteTokenHash String?          @unique
  inviteExpiresAt DateTime?        @db.Timestamptz(3)
  joinedAt        DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy User?    @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([userId, businessId])
  @@index([businessId, status])
}

// ─────────────────────────────── Catalog ───────────────────────────────

model Product {
  id             String              @id @default(cuid())
  businessId     String
  name           String
  sku            String?
  description    String?
  features       String[]
  benefits       String[]
  targetAudience String?
  categoryId     String?
  price          Decimal?            @db.Decimal(12, 2)
  /// Promotional price; must be lower than price. Null = no discount.
  discountPrice  Decimal?            @db.Decimal(12, 2)
  currency       String?
  /// Null means stock is not tracked/unknown. AI must never invent stock levels.
  stockQuantity  Int?
  availability   ProductAvailability @default(IN_STOCK)
  url            String?
  status         CatalogStatus       @default(DRAFT)
  attributes     Json?
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?           @db.Timestamptz(3)

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category?      @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  media    ProductMedia[]
  contents Content[]

  /// SKU is released (set to null) when a product is soft-deleted, so it can be reused.
  @@unique([businessId, sku])
  @@index([businessId, status])
  @@index([businessId, deletedAt])
  @@index([businessId, categoryId])
}

model Service {
  id                String              @id @default(cuid())
  businessId        String
  name              String
  description       String?
  features          String[]
  benefits          String[]
  targetAudience    String?
  categoryId        String?
  price             Decimal?            @db.Decimal(12, 2)
  currency          String?
  durationMinutes   Int?
  /// How customers book (e.g. "Call us", "Walk-in", "Online"), shown to customers and to the AI as fact.
  bookingInfo       String?
  bookingUrl        String?
  availability      ServiceAvailability @default(AVAILABLE)
  availabilityNotes String? // e.g. "Mon–Fri 9:00–18:00"
  status            CatalogStatus       @default(DRAFT)
  attributes        Json?
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?           @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation("ServiceCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  contents Content[]

  @@index([businessId, status])
  @@index([businessId, deletedAt])
  @@index([businessId, categoryId])
}

/// Business-defined category for products or services. Defaults are created from an industry template.
model Category {
  id          String       @id @default(cuid())
  businessId  String
  kind        CategoryKind
  name        String
  slug        String
  description String?
  isDefault   Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[] @relation("ProductCategory")
  services Service[] @relation("ServiceCategory")

  @@unique([businessId, kind, slug])
  @@index([businessId, kind, sortOrder])
}

/// Ordered product images/videos.
model ProductMedia {
  productId String
  mediaId   String
  position  Int    @default(0)

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
  @@index([mediaId])
}

/// Verified business knowledge used by the AI (customer support, content). Only APPROVED entries are used.
model KnowledgeEntry {
  id           String            @id @default(cuid())
  businessId   String
  source       KnowledgeSource
  sourceId     String?
  category     KnowledgeCategory @default(OTHER)
  title        String
  body         String
  /// Only verified entries are given to AI agents. Any edit resets verification.
  verified     Boolean           @default(false)
  verifiedAt   DateTime?         @db.Timestamptz(3)
  verifiedById String?
  createdById  String?
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?         @db.Timestamptz(3)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  verifiedBy User?    @relation("KnowledgeVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([businessId, verified])
  @@index([businessId, category])
  @@index([businessId, source, sourceId])
}

// ─────────────────────────────── Social ───────────────────────────────

model SocialAccount {
  id                String              @id @default(cuid())
  businessId        String
  platform          SocialPlatform
  externalAccountId String
  displayName       String?
  username          String?
  avatarUrl         String?
  status            SocialAccountStatus @default(CONNECTED)
  /// AES-256-GCM ciphertext (iv:tag:data, base64). Never returned by the API.
  accessTokenEnc    String
  refreshTokenEnc   String?
  tokenExpiresAt    DateTime?           @db.Timestamptz(3)
  scopes            String[]
  capabilities      Json? // provider-reported capabilities, e.g. { canPublishVideo: true }
  lastSyncedAt      DateTime?           @db.Timestamptz(3)
  lastError         String?
  connectedById     String?
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?           @db.Timestamptz(3)

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  publications       Publication[]
  conversations      Conversation[]
  comments           Comment[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@unique([businessId, platform, externalAccountId])
  @@index([businessId, platform])
  @@index([status, tokenExpiresAt])
}

// ─────────────────────────────── Content ───────────────────────────────

model Content {
  id              String           @id @default(cuid())
  businessId      String
  type            ContentType
  title           String?
  caption         String?
  language        String           @default("en")
  hashtags        String[]
  callToAction    String?
  targetPlatforms SocialPlatform[]
  status          ContentStatus    @default(DRAFT)
  origin          ContentOrigin    @default(HUMAN)
  productId       String?
  serviceId       String?
  campaignId      String? // parent CAMPAIGN content
  aiMetadata      Json? // prompt version, model, structured output; no secrets
  version         Int              @default(1)
  createdById     String?
  approvedById    String?
  approvedAt      DateTime?        @db.Timestamptz(3)
  rejectionReason String?
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?        @db.Timestamptz(3)

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  service        Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  campaign       Content?        @relation("CampaignItems", fields: [campaignId], references: [id], onDelete: SetNull)
  campaignItems  Content[]       @relation("CampaignItems")
  createdBy      User?           @relation("ContentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy     User?           @relation("ContentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  media          ContentMedia[]
  calendarEvents CalendarEvent[]
  publications   Publication[]

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId, deletedAt])
  @@index([campaignId])
}

model MediaAsset {
  id               String        @id @default(cuid())
  businessId       String
  type             MediaType
  status           MediaStatus   @default(PENDING_UPLOAD)
  storageKey       String        @unique
  originalFilename String
  /// Virtual folder for organization in the media library ("" = root).
  folder           String        @default("")
  tags             String[]
  mimeType         String
  sizeBytes        BigInt?
  width            Int?
  height           Int?
  durationSec      Decimal?      @db.Decimal(10, 3)
  checksumSha256   String?
  altText          String?
  origin           ContentOrigin @default(HUMAN)
  aiProvider       String?
  aiPrompt         String?
  rejectionReason  String?
  uploadedById     String?
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?     @db.Timestamptz(3)

  business   Business       @relation("BusinessMedia", fields: [businessId], references: [id], onDelete: Cascade)
  products   ProductMedia[]
  uploadedBy User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  contents   ContentMedia[]
  logoOf     Business?      @relation("BusinessLogo")

  @@index([businessId, type])
  @@index([businessId, deletedAt])
  @@index([businessId, folder])
  @@index([status, createdAt])
}

/// Ordered media attached to content (carousel order).
model ContentMedia {
  contentId String
  mediaId   String
  position  Int    @default(0)

  content Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([contentId, mediaId])
  @@index([mediaId])
}

model CalendarEvent {
  id          String              @id @default(cuid())
  businessId  String
  contentId   String?
  title       String
  notes       String?
  /// UTC instant.
  scheduledAt DateTime            @db.Timestamptz(3)
  /// IANA timezone the user planned in, retained to render and to recompute across DST.
  timezone    String
  status      CalendarEventStatus @default(PLANNED)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?           @db.Timestamptz(3)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  content      Content?      @relation(fields: [contentId], references: [id], onDelete: SetNull)
  publications Publication[]

  @@index([businessId, scheduledAt])
  @@index([contentId])
}

/// One publication attempt-set of a content item to one social account.
/// idempotencyKey guarantees the same content is never published twice to the same account for the same slot.
model Publication {
  id               String            @id @default(cuid())
  businessId       String
  contentId        String
  socialAccountId  String
  calendarEventId  String?
  platform         SocialPlatform
  mode             PublishMode       @default(API)
  status           PublicationStatus @default(PENDING)
  scheduledAt      DateTime          @db.Timestamptz(3)
  timezone         String
  idempotencyKey   String            @unique
  jobId            String?
  attempts         Int               @default(0)
  lockedUntil      DateTime?         @db.Timestamptz(3)
  /// Set only from a provider response. Presence = provider confirmed the post exists.
  externalPostId   String?
  externalUrl      String?
  providerResponse Json?
  lastError        String?
  publishedAt      DateTime?         @db.Timestamptz(3)
  cancelledAt      DateTime?         @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  content            Content             @relation(fields: [contentId], references: [id], onDelete: Cascade)
  socialAccount      SocialAccount       @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  calendarEvent      CalendarEvent?      @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  comments           Comment[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@unique([socialAccountId, externalPostId])
  @@index([businessId, status])
  @@index([status, scheduledAt])
  @@index([contentId])
}

// ─────────────────────────────── Inbox ───────────────────────────────

model Conversation {
  id                 String              @id @default(cuid())
  businessId         String
  socialAccountId    String?
  channel            ConversationChannel
  externalThreadId   String?
  customerExternalId String?
  customerName       String?
  status             ConversationStatus  @default(OPEN)
  escalated          Boolean             @default(false)
  escalationReason   EscalationReason?
  assignedToId       String?
  lastMessageAt      DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@unique([socialAccountId, externalThreadId])
  @@index([businessId, status, lastMessageAt])
}

model Message {
  id                String              @id @default(cuid())
  businessId        String
  conversationId    String
  direction         MessageDirection
  authorType        MessageAuthorType
  authorUserId      String?
  body              String
  externalMessageId String?
  approvalStatus    ReplyApprovalStatus @default(NOT_REQUIRED)
  escalationReason  EscalationReason?
  aiMetadata        Json?
  sentAt            DateTime?           @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorUser   User?        @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@unique([conversationId, externalMessageId])
  @@index([businessId, createdAt])
  @@index([conversationId, createdAt])
}

model Comment {
  id                String              @id @default(cuid())
  businessId        String
  socialAccountId   String
  publicationId     String?
  externalCommentId String
  parentId          String?
  authorExternalId  String?
  authorName        String?
  body              String
  isFromBusiness    Boolean             @default(false)
  hidden            Boolean             @default(false)
  approvalStatus    ReplyApprovalStatus @default(NOT_REQUIRED)
  postedAt          DateTime?           @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  publication   Publication?  @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  parent        Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]     @relation("CommentReplies")

  @@unique([socialAccountId, externalCommentId])
  @@index([businessId, createdAt])
  @@index([publicationId])
}

// ─────────────────────────────── Billing ───────────────────────────────

model Plan {
  id              String          @id @default(cuid())
  code            PlanCode        @unique
  name            String
  description     String?
  priceAmount     Decimal         @db.Decimal(12, 2)
  currency        String          @default("USD")
  interval        BillingInterval @default(MONTH)
  /// Payment-provider price identifier (e.g. Stripe price id). Null = not configured with provider.
  providerPriceId String?         @unique
  /// Limits e.g. { "businesses": 1, "socialAccounts": 3, "aiCreditsPerMonth": 200, "seats": 2 }
  limits          Json
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  businessId             String             @unique
  planId                 String
  status                 SubscriptionStatus @default(INCOMPLETE)
  provider               String             @default("stripe")
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  currentPeriodStart     DateTime?          @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?          @db.Timestamptz(3)
  trialEndsAt            DateTime?          @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([status])
  @@index([providerCustomerId])
}

/// No card data is ever stored. Only provider references and amounts.
model Payment {
  id                String        @id @default(cuid())
  businessId        String
  subscriptionId    String?
  provider          String        @default("stripe")
  providerPaymentId String        @unique
  providerInvoiceId String?
  amount            Decimal       @db.Decimal(12, 2)
  amountRefunded    Decimal       @default(0) @db.Decimal(12, 2)
  currency          String
  status            PaymentStatus
  description       String?
  invoiceUrl        String?
  paidAt            DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
}

// ─────────────────────────────── Analytics ───────────────────────────────

model AnalyticsSnapshot {
  id              String         @id @default(cuid())
  businessId      String
  socialAccountId String?
  publicationId   String?
  platform        SocialPlatform
  period          SnapshotPeriod
  periodStart     DateTime       @db.Timestamptz(3)
  periodEnd       DateTime       @db.Timestamptz(3)
  source          MetricSource   @default(MEASURED)
  /// Null = metric not available from provider (never zero-filled).
  reach           Int?
  impressions     Int?
  views           Int?
  likes           Int?
  comments        Int?
  shares          Int?
  saves           Int?
  linkClicks      Int?
  engagementRate  Decimal?       @db.Decimal(8, 4)
  followers       Int?
  raw             Json?
  fetchedAt       DateTime       @default(now()) @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  publication   Publication?   @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, publicationId, period, periodStart, source])
  @@index([businessId, periodStart])
  @@index([publicationId])
}

// ─────────────────────────────── Platform ───────────────────────────────

model Notification {
  id         String              @id @default(cuid())
  userId     String
  businessId String?
  channel    NotificationChannel @default(IN_APP)
  type       String
  title      String
  body       String?
  data       Json?
  readAt     DateTime?           @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// Append-only security & business audit trail. Never store secrets or tokens in metadata.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  businessId String?
  action     String // e.g. auth.login, auth.login_failed, business.create
  entityType String?
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor    User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

/// Inbound provider webhooks. (provider, externalEventId) unique => idempotent processing.
model WebhookEvent {
  id              String          @id @default(cuid())
  provider        WebhookProvider
  externalEventId String
  type            String
  signatureValid  Boolean
  status          WebhookStatus   @default(RECEIVED)
  payload         Json
  error           String?
  attempts        Int             @default(0)
  receivedAt      DateTime        @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?       @db.Timestamptz(3)

  @@unique([provider, externalEventId])
  @@index([status, receivedAt])
}

model AIUsage {
  id           String   @id @default(cuid())
  businessId   String
  userId       String?
  agent        AIAgent
  provider     String
  model        String
  operation    String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  imageCount   Int      @default(0)
  videoSeconds Decimal  @default(0) @db.Decimal(10, 3)
  credits      Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(12, 6)
  success      Boolean  @default(true)
  error        String?
  latencyMs    Int?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([agent, createdAt])
}
