{
  "name": "aima",
  "private": true,
  "description": "Project AIMA - AI-powered marketing automation SaaS",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @aima/api test:e2e",
    "test:web-e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "db:generate": "pnpm --filter @aima/database db:generate",
    "db:migrate": "pnpm --filter @aima/database db:migrate",
    "db:deploy": "pnpm --filter @aima/database db:deploy",
    "db:seed": "pnpm --filter @aima/database db:seed",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d postgres redis minio",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "@nestjs/core",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "msgpackr-extract"
    ]
  }
}
